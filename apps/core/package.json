{
  "name": "@unify/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Standalone UNIFY control-plane core",
  "exports": {
    ".": "./dist/index.js",
    "./contracts/v1": "./dist/contracts/v1/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "contracts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:contracts": "pnpm run build && node scripts/generate-openapi.mjs",
    "check:contracts": "pnpm run build && node scripts/check-openapi.mjs",
    "test": "pnpm run build && node --test dist/core.test.js dist/contracts/v1/contracts.test.js && node scripts/check-openapi.mjs",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  }
}

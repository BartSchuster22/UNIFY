{
  "name": "@aquiero/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --passWithNoTests --maxWorkers=1 --no-file-parallelism",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:status": "node scripts/migrate.mjs status",
    "bootstrap-admin": "node dist/cli/bootstrap-admin.js",
    "start": "node dist/server.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aquiero/adapter-sdk": "workspace:*",
    "@aquiero/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "fastify": "5.10.0",
    "pg": "8.22.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/pg": "8.20.0",
    "@types/ws": "8.18.1"
  }
}

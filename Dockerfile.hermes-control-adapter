# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG NODE_BUILD_IMAGE=node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f
ARG HERMES_RUNTIME_IMAGE=nousresearch/hermes-agent@sha256:fcbe95482353e41cd30d39ddfc0f57ba3720f6da6969a7a69cdfb0d84b045cb6

FROM ${NODE_BUILD_IMAGE} AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/contracts/package.json packages/contracts/package.json
COPY apps/hermes-control-adapter/package.json apps/hermes-control-adapter/package.json
RUN pnpm install --frozen-lockfile --filter @aquiero/hermes-control-adapter...
COPY packages/contracts packages/contracts
COPY apps/hermes-control-adapter apps/hermes-control-adapter
RUN pnpm --filter @aquiero/contracts build \
 && pnpm --filter @aquiero/hermes-control-adapter build \
 && pnpm --filter @aquiero/hermes-control-adapter deploy --prod --legacy /out \
 && rm -rf /out/node_modules/.cache

FROM ${HERMES_RUNTIME_IMAGE} AS runtime
LABEL org.opencontainers.image.title="UNIFY Hermes Control Adapter" \
      org.opencontainers.image.source="https://github.com/BartSchuster22/UNIFY" \
      org.opencontainers.image.licenses="UNLICENSED"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=28082 \
    HERMES_REPO=/opt/hermes HERMES_BIN=/opt/hermes/.venv/bin/hermes HERMES_HOME=/opt/data
WORKDIR /opt/unify-adapter
COPY --from=build --chown=1000:1000 /out/ ./
USER 1000:1000
EXPOSE 28082
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 CMD ["node","-e","const https=require('https');const r=https.get({hostname:'127.0.0.1',port:process.env.PORT||28082,path:'/control/v1/health',rejectUnauthorized:false,headers:{authorization:'Bearer invalid-health-probe'}},x=>process.exit(x.statusCode===401?0:1));r.on('error',()=>process.exit(1))"]
CMD ["node","dist/server.js"]
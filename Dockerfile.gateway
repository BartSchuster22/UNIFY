# syntax=docker/dockerfile:1.7
FROM node:22.22.2-alpine AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @aquiero/gateway build && pnpm --filter @aquiero/gateway deploy --prod --legacy /out

FROM node:22.22.2-alpine AS runtime
ENV NODE_ENV=production HOST=0.0.0.0 PORT=8080
RUN addgroup -S -g 10001 unify && adduser -S -D -H -u 10001 -G unify unify
WORKDIR /app
COPY --from=build --chown=10001:10001 /out/ ./
USER 10001:10001
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:8080/api/v1/health/ready').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","dist/server.js"]

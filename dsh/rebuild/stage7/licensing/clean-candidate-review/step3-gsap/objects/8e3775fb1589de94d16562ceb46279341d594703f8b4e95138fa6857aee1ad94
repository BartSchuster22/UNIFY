    --animation-delay-d0: 0s;
    --animation-delay-d1: 0.3s;
    --animation-delay-d2: 0.45s;
    --animation-delay-d3: 0.75s;
    --animation-delay-d4: 1.2s;
    --animation-delay-d5: 1.95s;
    --animation-delay-d6: 2.7s;   
    --animation-delay-d7: 3.45s;    

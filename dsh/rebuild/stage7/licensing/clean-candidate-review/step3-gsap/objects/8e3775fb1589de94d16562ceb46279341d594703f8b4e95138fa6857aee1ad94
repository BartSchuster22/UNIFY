    padding-block: 0.1em;
    margin-block: -0.1em;
    color: transparent;
    --line-width: 100%;
    position: relative;
    background-color: color-mix(in hsl, var(--colors--text) 20%, transparent);
    background-image: linear-gradient(90deg, var(--colors--text), var(--colors--text) var(--line-width), hsla(0, 0%, 100%, 0) var(--line-width));
    background-clip: text;
  }


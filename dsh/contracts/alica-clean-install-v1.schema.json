{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.alica.invalid/alica-clean-install-v1.schema.json",
  "title": "ALICA unified clean installation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cellId",
    "installationRoot",
    "publicHost",
    "publicOrigin",
    "project",
    "adminUsername",
    "eulaDigest",
    "eulaAccepted"
  ],
  "properties": {
    "schemaVersion": { "const": "alica-clean-install/v1" },
    "cellId": {
      "type": "string",
      "pattern": "^ins_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "installationRoot": { "type": "string", "pattern": "^/(?:[A-Za-z0-9._-]+/?)+$" },
    "publicHost": { "type": "string", "minLength": 1, "maxLength": 253 },
    "publicOrigin": { "type": "string", "pattern": "^https://[^/]+$" },
    "project": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$" },
    "adminUsername": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "eulaDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "eulaAccepted": { "const": true }
  }
}

{
  "name": "@aquiero/unify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "overrides": {
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "fast-json-stringify>fast-uri": "4.1.2",
      "fastify>find-my-way": "9.7.0"
    }
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm --filter @aquiero/contracts build && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-standalone-runtime.mjs",
    "sot:check": "node scripts/check-standalone-runtime.mjs",
    "hermes:fixture:verify": "node scripts/verify-hermes-pinned-contract.mjs",
    "hermes:adapter:verify": "pnpm --filter @aquiero/contracts build && pnpm --filter @aquiero/hermes-control-adapter build && node scripts/verify-hermes-adapter-foundations.mjs",
    "hermes:adapter:postgres:verify": "pnpm --filter @aquiero/contracts build && pnpm --filter @aquiero/hermes-control-adapter build && node scripts/verify-hermes-adapter-postgres.mjs",
    "format:check": "prettier --check .",
    "contracts:generate": "pnpm --filter @aquiero/contracts build && node scripts/generate-contracts.mjs",
    "contracts:check": "pnpm --filter @aquiero/contracts build && node scripts/generate-contracts.mjs --check",
    "compose:secrets": "node scripts/prepare-compose-secrets.mjs",
    "compose:build": "docker compose build gateway uniui chat-pwa alerts-pwa",
    "compose:up": "docker compose up -d --wait postgres gateway uniui chat-pwa alerts-pwa",
    "compose:down": "docker compose down --remove-orphans",
    "backup": "bash scripts/backup-gateway.sh",
    "backup:prune": "node scripts/prune-gateway-backups.mjs",
    "backup:prune:dry-run": "node scripts/prune-gateway-backups.mjs --dry-run",
    "backup:prune:self-test": "node scripts/prune-gateway-backups.test.mjs",
    "identity:capacity": "node scripts/identity-capacity-gate.mjs",
    "identity:capacity:self-test": "node scripts/identity-capacity-gate.mjs --self-test",
    "restore:rehearse": "bash scripts/rehearse-restore.sh",
    "performance:smoke": "node scripts/performance-smoke.mjs",
    "canary:self-test": "node scripts/production-canary.mjs --self-test",
    "canary:production": "node scripts/production-canary.mjs --verify-local",
    "audit:verify": "docker compose exec -T gateway node dist/cli/verify-audit.js",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "standalone:check": "node scripts/check-standalone-runtime.mjs",
    "qa": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm contracts:check && pnpm standalone:check && pnpm backup:prune:self-test && pnpm identity:capacity:self-test && pnpm canary:self-test && pnpm format:check",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.3",
    "@sinclair/typebox": "0.34.52",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}

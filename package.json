{
  "name": "@aquiero/unify",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ],
    "overrides": {
      "@fastify/ajv-compiler>fast-uri": "3.1.5",
      "fast-json-stringify>fast-uri": "4.1.2",
      "fastify>find-my-way": "9.7.0"
    }
  },
  "engines": {
    "node": ">=22.22.2 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "typecheck": "pnpm --filter @aquiero/contracts build && pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && vitest run scripts/framework-rollout-worker.test.mjs && python3 -m unittest discover -s integrations/hermes/unify-memory/tests -p 'test_*.py'",
    "lint": "eslint . && node scripts/check-boundaries.mjs && node scripts/check-standalone-runtime.mjs && node scripts/verify-production-images.mjs --static && node scripts/verify-hermes-combined-image.mjs && node scripts/verify-five-service-compose.mjs && node scripts/verify-unify-web-compose.mjs && node scripts/validate-five-service-installation.mjs deploy/five-service/installation-inputs.example.json && node scripts/verify-five-service-installer.mjs && node scripts/verify-alica-identity-shadow.mjs",
    "sot:check": "node scripts/check-standalone-runtime.mjs",
    "hermes:fixture:verify": "node scripts/verify-hermes-pinned-contract.mjs",
    "hermes:adapter:verify": "pnpm --filter @aquiero/contracts build && pnpm --filter @aquiero/hermes-control-adapter build && node scripts/verify-hermes-adapter-foundations.mjs",
    "hermes:adapter:postgres:verify": "pnpm --filter @aquiero/contracts build && pnpm --filter @aquiero/hermes-control-adapter build && node scripts/verify-hermes-adapter-postgres.mjs",
    "hermes:image:check": "node scripts/verify-hermes-combined-image.mjs",
    "hermes:image:verify": "node scripts/verify-hermes-combined-runtime.mjs",
    "five-service:check": "node scripts/verify-five-service-compose.mjs",
    "unify-web:check": "node scripts/verify-unify-web-compose.mjs",
    "unify-web:build": "docker buildx build --load --file Dockerfile.uniui --tag unify-web:local .",
    "five-service:verify": "node scripts/verify-five-service-runtime.mjs",
    "five-service:installer:verify": "node scripts/verify-five-service-installer.mjs",
    "five-service:conformance:verify": "node scripts/verify-alica-release-conformance.mjs",
    "five-service:identity-shadow:verify": "node scripts/verify-alica-identity-shadow.mjs",
    "five-service:identity-live:verify": "node scripts/verify-alica-live-identity-inventory.mjs",
    "five-service:hermes-phase1:verify": "pnpm --filter @aquiero/contracts build && node scripts/verify-alica-hermes-phase1-inventory.mjs",
    "five-service:hermes-phase3:generate": "pnpm --filter @aquiero/contracts build && node scripts/generate-alica-hermes-contract-fixtures.mjs",
    "five-service:hermes-phase3:verify": "pnpm --filter @aquiero/contracts build && node scripts/generate-alica-hermes-contract-fixtures.mjs --check && node scripts/verify-alica-hermes-contract-conformance.mjs",
    "five-service:hermes-phase4:generate": "pnpm --filter @aquiero/contracts build && node scripts/generate-alica-hermes-authorization-shadow-fixtures.mjs",
    "five-service:hermes-phase4:verify": "pnpm --filter @aquiero/contracts build && node scripts/generate-alica-hermes-authorization-shadow-fixtures.mjs --check && node scripts/verify-alica-hermes-authorization-shadow.mjs",
    "five-service:hermes-phase5:verify": "node scripts/verify-alica-hermes-phase5-migration.mjs",
    "five-service:hermes-phase5:rehearse": "pnpm five-service:hermes-phase5:verify && node scripts/rehearse-alica-hermes-phase5.mjs",
    "five-service:hermes-phase6:verify": "node scripts/verify-alica-hermes-phase6-evidence.mjs",
    "five-service:hermes-phase6:observe-live": "node scripts/verify-alica-hermes-phase6-live.mjs --observe",
    "five-service:hermes-phase7:verify": "node scripts/verify-alica-hermes-phase7-canary.mjs",
    "five-service:hermes-phase7:preflight": "node scripts/run-alica-hermes-phase7-canary.mjs --preflight",
    "five-service:hermes-phase7:seed": "node scripts/run-alica-hermes-phase7-canary.mjs --seed",
    "five-service:hermes-phase7:repair-preflight": "node scripts/run-alica-hermes-phase7-canary.mjs --repair-preflight",
    "five-service:hermes-phase7:recover-transport": "node scripts/run-alica-hermes-phase7-canary.mjs --recover-transport",
    "five-service:hermes-phase7:reconcile-created": "node scripts/run-alica-hermes-phase7-canary.mjs --reconcile-created",
    "five-service:hermes-phase7:resume-rollback": "node scripts/run-alica-hermes-phase7-canary.mjs --resume-rollback",
    "five-service:hermes-phase7:reconcile-deleted": "node scripts/run-alica-hermes-phase7-canary.mjs --reconcile-deleted",
    "five-service:hermes-phase7:canary": "node scripts/run-alica-hermes-phase7-canary.mjs --canary",
    "five-service:hermes-phase7:faults": "node scripts/run-alica-hermes-phase7-canary.mjs --faults",
    "five-service:hermes-phase7:reconcile-faults": "node scripts/run-alica-hermes-phase7-canary.mjs --reconcile-faults",
    "five-service:hermes-phase7:disable": "node scripts/run-alica-hermes-phase7-canary.mjs --disable",
    "five-service:hermes-phase8:verify": "node scripts/verify-alica-hermes-phase8-chat-integration.mjs",
    "five-service:hermes-phase9:canary": "node scripts/run-alica-hermes-phase9-canary.mjs",
    "five-service:hermes-phase9:verify": "node scripts/verify-alica-hermes-phase9-canary.mjs",
    "framework:rollout:store:verify": "node scripts/verify-framework-rollout-store.mjs",
    "framework:rollout:worker:verify-real": "node scripts/verify-framework-rollout-worker-real.mjs",
    "phase-14-5:live": "node scripts/verify-hermes-combined-runtime.mjs && node scripts/verify-five-service-runtime.mjs && node scripts/verify-five-service-installer-runtime.mjs",
    "format:check": "prettier --check .",
    "contracts:generate": "pnpm --filter @aquiero/contracts build && node scripts/generate-contracts.mjs",
    "contracts:check": "pnpm --filter @aquiero/contracts build && node scripts/generate-contracts.mjs --check",
    "compose:secrets": "node scripts/prepare-compose-secrets.mjs",
    "compose:build": "docker compose build gateway uniui chat-pwa alerts-pwa",
    "compose:up": "docker compose up -d --wait postgres gateway uniui chat-pwa alerts-pwa",
    "compose:down": "docker compose down --remove-orphans",
    "backup": "bash scripts/backup-gateway.sh",
    "backup:prune": "node scripts/prune-gateway-backups.mjs",
    "backup:prune:dry-run": "node scripts/prune-gateway-backups.mjs --dry-run",
    "backup:prune:self-test": "node scripts/prune-gateway-backups.test.mjs",
    "identity:capacity": "node scripts/identity-capacity-gate.mjs",
    "identity:capacity:self-test": "node scripts/identity-capacity-gate.mjs --self-test",
    "restore:rehearse": "bash scripts/rehearse-restore.sh",
    "performance:smoke": "node scripts/performance-smoke.mjs",
    "canary:self-test": "node scripts/production-canary.mjs --self-test",
    "canary:production": "node scripts/production-canary.mjs --verify-local",
    "audit:verify": "docker compose exec -T gateway node dist/cli/verify-audit.js",
    "security:audit": "pnpm audit --prod --audit-level high",
    "security:sbom": "node scripts/generate-sbom.mjs",
    "standalone:check": "node scripts/check-standalone-runtime.mjs",
    "image:check": "node scripts/verify-production-images.mjs --static",
    "image:verify": "node scripts/verify-production-images.mjs",
    "qa": "pnpm lint && pnpm typecheck && pnpm five-service:hermes-phase3:verify && pnpm five-service:hermes-phase4:verify && pnpm five-service:hermes-phase5:verify && pnpm five-service:hermes-phase6:verify && pnpm five-service:hermes-phase7:verify && pnpm five-service:hermes-phase8:verify && pnpm five-service:hermes-phase9:verify && pnpm test && pnpm build && pnpm contracts:check && pnpm standalone:check && pnpm backup:prune:self-test && pnpm identity:capacity:self-test && pnpm canary:self-test && pnpm format:check",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.3",
    "@sinclair/typebox": "0.34.52",
    "eslint": "9.39.1",
    "globals": "16.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}

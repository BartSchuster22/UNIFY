# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
ARG APP
ARG NODE_BUILD_IMAGE=node:22.22.2-alpine@sha256:8ea2348b068a9544dae7317b4f3aafcdc032df1647bb7d768a05a5cad1a7683f
ARG NODE_RUNTIME_IMAGE=gcr.io/distroless/nodejs22-debian13:nonroot@sha256:939d6f1671529d230f50b563578e9b5d206af58f038b10ebd7e1233023d4e167

FROM ${NODE_BUILD_IMAGE} AS build
ARG APP
ARG VITE_UNIUI_URL
ENV VITE_UNIUI_URL=$VITE_UNIUI_URL PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/auth-client/package.json packages/auth-client/package.json
COPY packages/design-system/package.json packages/design-system/package.json
COPY packages/chat-components/package.json packages/chat-components/package.json
COPY packages/notification-components/package.json packages/notification-components/package.json
COPY apps/${APP}/package.json apps/${APP}/package.json
RUN pnpm install --frozen-lockfile --filter "@aquiero/${APP}..."
COPY packages/auth-client packages/auth-client
COPY packages/design-system packages/design-system
COPY packages/chat-components packages/chat-components
COPY packages/notification-components packages/notification-components
COPY apps/${APP} apps/${APP}
RUN pnpm --filter "@aquiero/${APP}" build

FROM ${NODE_RUNTIME_IMAGE} AS runtime
ARG APP
LABEL org.opencontainers.image.title="UNIFY Focused PWA" \
      org.opencontainers.image.source="https://github.com/BartSchuster22/UNIFY" \
      org.opencontainers.image.licenses="UNLICENSED"
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 GATEWAY_INTERNAL_URL=http://gateway:8080
WORKDIR /app
COPY --from=build --chown=65532:65532 /workspace/apps/${APP}/dist ./public
COPY --chown=65532:65532 apps/uniui/server.mjs ./server.mjs
USER 65532:65532
EXPOSE 3000
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD ["/nodejs/bin/node","-e","fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["server.mjs"]

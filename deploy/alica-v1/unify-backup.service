[Unit]
Description=Encrypted UNIFY PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/opt/unify/backup.sh
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/unify/backups
ReadOnlyPaths=/opt/unify/secrets /opt/unify/backup.sh

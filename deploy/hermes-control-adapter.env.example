# Install independently as /etc/unify/hermes-control-alica.env and
# /etc/unify/hermes-control-herman.env with mode 0600. Never reuse endpoint,
# instance ID, database credential, token bundle, or TLS private key.
HOST=10.20.0.2
PORT=28082
HERMES_REPO=/home/herman/.hermes/hermes-agent
HERMES_HOME=/home/herman/.hermes/profiles/alica
HERMES_BIN=/home/herman/.local/bin/hermes
HERMES_FRAMEWORK_ID=hermes-alica
HERMES_DISPLAY_NAME=Alica
HERMES_INSTANCE_ID=alica-private-1
HERMES_ADAPTER_SCOPES=control:read,control:execute,control:events,control:secrets
HERMES_MANAGEMENT_BASE_URL=http://127.0.0.1:29119
HERMES_MANAGEMENT_AUTOSTART=true
DATABASE_URL_FILE=/run/secrets/unify-frameworks/alica-database-url
HERMES_ADAPTER_TOKEN_BUNDLE_FILE=/run/secrets/unify-frameworks/alica-adapter-token.json
HERMES_ADAPTER_TOKEN_CACHE_TTL_MS=1000
HERMES_ADAPTER_TLS_KEY_FILE=/run/secrets/unify-frameworks/alica-tls.key
HERMES_ADAPTER_TLS_CERT_FILE=/run/secrets/unify-frameworks/alica-tls.crt
# Optional native Hermes API access; keep this credential framework-specific.
# HERMES_API_BASE_URL=http://127.0.0.1:8080
# HERMES_API_TOKEN_FILE=/run/secrets/unify-frameworks/alica-api-token

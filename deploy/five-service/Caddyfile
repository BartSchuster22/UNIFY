{
	http_port 8080
	https_port 8443
	admin off
}

{$UNIFY_PUBLIC_HOST} {
	encode zstd gzip

	@health path /healthz
	respond @health 200

	reverse_proxy unify-core:8080

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}

	log {
		output file /var/log/caddy/unify-access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}

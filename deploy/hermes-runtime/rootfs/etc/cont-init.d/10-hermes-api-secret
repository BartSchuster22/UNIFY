#!/command/with-contenv bash
set -euo pipefail

secret_path="${HERMES_API_TOKEN_FILE:-/run/secrets/hermes-api-token}"
if [[ ! -r "$secret_path" ]]; then
  echo "Hermes API token secret is unavailable: $secret_path" >&2
  exit 1
fi

api_key="$(tr -d '\r\n' < "$secret_path")"
if (( ${#api_key} < 32 )); then
  echo "Hermes API token secret is invalid" >&2
  exit 1
fi

install -d -m 0755 /var/run/s6/container_environment
printf '%s' "$api_key" > /var/run/s6/container_environment/API_SERVER_KEY
chmod 0600 /var/run/s6/container_environment/API_SERVER_KEY
unset api_key
# Native per-profile services inherit s6's environment, not the bootstrap
# requester's shell. Keep the native API explicitly private and enabled.
printf '%s' true > /var/run/s6/container_environment/API_SERVER_ENABLED
printf '%s' "${HERMES_API_HOST:-127.0.0.1}" > /var/run/s6/container_environment/API_SERVER_HOST
printf '%s' "${HERMES_API_PORT:-8642}" > /var/run/s6/container_environment/API_SERVER_PORT

# syntax=docker/dockerfile:1.7
FROM node:22.22.2-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 GATEWAY_INTERNAL_URL=http://gateway:8080
RUN addgroup -S -g 10001 unify && adduser -S -D -H -u 10001 -G unify unify
WORKDIR /app
COPY --chown=10001:10001 apps/uniui/server.mjs apps/uniui/index.html ./
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:3000/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","server.mjs"]

# syntax=docker/dockerfile:1.7
FROM node:22.22.2-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@10.33.2 --activate
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/auth-client/package.json packages/auth-client/package.json
COPY packages/chat-components/package.json packages/chat-components/package.json
COPY packages/notification-components/package.json packages/notification-components/package.json
COPY apps/uniui/package.json apps/uniui/package.json
RUN pnpm install --frozen-lockfile --filter @aquiero/uniui...
COPY packages/auth-client packages/auth-client
COPY packages/chat-components packages/chat-components
COPY packages/notification-components packages/notification-components
COPY apps/uniui apps/uniui
RUN pnpm --filter @aquiero/uniui build

FROM node:22.22.2-alpine
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000 GATEWAY_INTERNAL_URL=http://gateway:8080
RUN addgroup -S -g 10001 unify && adduser -S -D -H -u 10001 -G unify unify
WORKDIR /app
COPY --from=build --chown=10001:10001 /workspace/apps/uniui/dist ./public
COPY --chown=10001:10001 apps/uniui/server.mjs ./server.mjs
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD ["node","-e","fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node","server.mjs"]
